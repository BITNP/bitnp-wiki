---
import { getCollection } from 'astro:content';
import '../styles/index.scss';

interface Props {
  title: string;
  mermaid?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, mermaid, headings } = Astro.props;

const tocHeadings = headings?.filter(h => h.depth >= 2 && h.depth <= 3) || [];

const docs = await getCollection('docs');

type NavItem = {
  id: string;
  title: string;
  slug: string;
  children: NavItem[];
};

function buildNavTree(docs: any[]): NavItem[] {
  const root: NavItem[] = [];

  for (const doc of docs) {
    const parts = doc.id.split('/');
    let current = root;
    let currentPath = '';

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      currentPath = currentPath ? `${currentPath}/${part}` : part;

      let item = current.find(n => n.id === part);
      if (!item) {
        item = {
          id: part,
          title: part,
          slug: currentPath,
          children: [],
        };
        current.push(item);
      }

      if (i === parts.length - 1) {
        item.title = doc.data.title || part;
        item.slug = doc.id === 'index' ? '' : doc.id;
      }

      current = item.children;
    }
  }

  return root;
}

const navTree = buildNavTree(docs);
const currentPath = Astro.url.pathname.replace(/^\/|\/$/g, '');

function renderNav(items: NavItem[], depth: number = 0): string {
  if (items.length === 0) return '';

  items.sort((a, b) => a.title.localeCompare(b.title, 'zh-CN'));

  let html = `<ul class="nav-list" style="padding-left: ${depth === 0 ? 0 : 16}px;">`;
  for (const item of items) {
    const isActive = item.slug === currentPath;
    const href = item.slug === '' ? '/' : `/${item.slug}/`;
    html += `<li style="margin: 4px 0;">`;
    html += `<a href="${href}" class="nav-link${isActive ? ' active' : ''}">${item.title}</a>`;
    if (item.children.length > 0) {
      html += renderNav(item.children, depth + 1);
    }
    html += `</li>`;
  }
  html += `</ul>`;
  return html;
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
</head>
<body>
  <div class="container">
    <nav class="sidebar">
      <div class="site-title" style="margin-bottom: 20px;">
        <a href="/">网协Wiki</a>
      </div>
      <Fragment set:html={renderNav(navTree)} />
    </nav>
    <main class="content">
      <slot />
    </main>
    {tocHeadings.length > 0 && (
      <aside class="toc-sidebar">
        <div class="toc-title">目录</div>
        <ul class="toc-list">
          {tocHeadings.map(h => (
            <li class={`toc-item toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
  {mermaid && (
    <script src="../scripts/mermaid.ts"></script>
  )}
  {tocHeadings.length > 0 && (
    <script src="../scripts/toc.ts"></script>
  )}
</body>
</html>
