---
interface Props {
  type?: "info" | "warning" | "danger" | "success";
}

const { type = "info" } = Astro.props;
---

<div class={`alert is-${type}`}>
  <div class="alert-header">
    <span class="alert-icon">
      {
        type === "info" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
              fill="currentColor"
            />
          </svg>
        )
      }
      {
        type === "warning" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M1 21h22L12 2L1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
              fill="currentColor"
            />
          </svg>
        )
      }
      {
        type === "danger" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M15.73 3H8.27L3 8.27v7.46L8.27 21h7.46L21 15.73V8.27L15.73 3zM19 14.9L14.9 19H9.1L5 14.9V9.1L9.1 5h5.8L19 9.1v5.8zm-4.17-7.14L12 10.59L9.17 7.76L7.76 9.17L10.59 12l-2.83 2.83l1.41 1.41L12 13.41l2.83 2.83l1.41-1.41L13.41 12l2.83-2.83l-1.41-1.41z"
              fill="currentColor"
            />
          </svg>
        )
      }
      {
        type === "success" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M9 16.17L4.83 12l-1.42 1.41L9 19L21 7l-1.41-1.41L9 16.17z"
              fill="currentColor"
            />
          </svg>
        )
      }
    </span>
    <span>
      {type === "info" && "Info"}
      {type === "warning" && "Warning"}
      {type === "danger" && "Danger"}
      {type === "success" && "Success"}
    </span>
  </div>
  <div class="alert-content"><slot /></div>
</div>
