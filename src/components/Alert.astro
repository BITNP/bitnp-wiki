---
import { Icon } from "astro-icon/components";

interface Props {
  type?: "info" | "warning" | "danger" | "success";
}

const { type = "info" } = Astro.props;
---

<div class={`alert is-${type}`}>
  <div class="alert-header">
    <span class="alert-icon">
      {type === "info" && <Icon name="mdi:information" />}
      {type === "warning" && <Icon name="mdi:alert" />}
      {type === "danger" && <Icon name="mdi:shield-alert" />}
      {type === "success" && <Icon name="mdi:check" />}
    </span>
    <span>
      {type === "info" && "Info"}
      {type === "warning" && "Warning"}
      {type === "danger" && "Danger"}
      {type === "success" && "Success"}
    </span>
  </div>
  <div class="alert-content"><slot /></div>
</div>
